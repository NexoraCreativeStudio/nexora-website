# Build output — generated multilingual pages. Never commit generated artifacts.
dist/

# Local environment / secrets — never commit real credentials.
# ops/payment-integration/.env.example is the tracked placeholder template.
.env
.env.*
!.env.example

# Proposal System — real client proposal instances and generated output are private.
# Never commit real client data (names, emails, phones, addresses, negotiated prices,
# signatures, accepted/signed proposals, project details). Committed fixtures under
# ops/proposals/examples/ are synthetic only and must carry "_example": true.
ops/proposals/private/
ops/proposals/out/

# Agreement System (PROP.5) — real Agreements and generated Agreement documents are private.
# Never commit real client data (names, emails, phones, addresses, negotiated prices,
# accepted/signed Agreements, handoffs, execution/signature material). Committed fixtures
# under ops/agreements/examples/ are synthetic only and must carry "_example": true.
ops/agreements/private/
ops/agreements/out/
