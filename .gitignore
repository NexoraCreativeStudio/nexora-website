# Build output — generated multilingual pages. Never commit generated artifacts.
dist/

# Local environment / secrets — never commit real credentials.
# ops/payment-integration/.env.example is the tracked placeholder template.
.env
.env.*
!.env.example

# Proposal System — real client proposal instances and generated output are private.
# Never commit real client data (names, emails, phones, addresses, negotiated prices,
# signatures, accepted/signed proposals, project details). Committed fixtures under
# ops/proposals/examples/ are synthetic only and must carry "_example": true.
ops/proposals/private/
ops/proposals/out/

# Agreement System (PROP.5) — real Agreements and generated Agreement documents are private.
# Never commit real client data (names, emails, phones, addresses, negotiated prices,
# accepted/signed Agreements, handoffs, execution/signature material). Committed fixtures
# under ops/agreements/examples/ are synthetic only and must carry "_example": true.
ops/agreements/private/
ops/agreements/out/

# Document Output System (PROP.6) — final generated client documents (HTML/PDF/manifest/
# checksums) and real document private areas are private. Never commit real client data.
# Committed fixtures under ops/proposals/examples/ and ops/agreements/examples/ are synthetic.
ops/documents/private/
ops/documents/out/

# Agreement Execution System (PROP.7) — execution packages, execution records, evidence,
# audit trails and executed bundles are private. Never commit real signer names/emails,
# real signatures, provider responses, provider request/document ids, or execution evidence.
# Committed fixtures under ops/execution/examples/ are synthetic only and must carry
# "_example": true. The real e-signature provider is unresolved (OWNER DECISION REQUIRED).
ops/execution/private/
ops/execution/out/

# Invoice & Billing Engine (PROP.8) — real invoices, billing schedules, Go-Live
# records, recurring-billing state and payment/reconciliation material are private.
# Never commit real client invoices, addresses, prices, billing history, bank
# details, or payment records. Committed fixtures under ops/billing/examples/ are
# synthetic only and must carry "_example": true.
ops/billing/private/
ops/billing/out/

# Payment Runtime (PROP.11/12) — real payment portal sessions, webhook events,
# reconciliation evidence, and payment records are private.
# Never commit real client payment data. Committed fixtures under ops/payment/examples/
# are synthetic only and must carry "_example": true.
ops/payment/private/
ops/payment/out/
